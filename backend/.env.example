# Copy to .env and fill in. Never commit the real .env.
# Full reference: backend/README.md

APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Required in production — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/audio_instructions

OPENAI_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# Password-reset emails. Signup OTP emails use EMAIL_USER / EMAIL_PASS,
# which fall back to these when unset.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
EMAIL_USER=
EMAIL_PASS=

# Google sign-in (comma-separated client IDs)
GOOGLE_OAUTH_CLIENT_IDS=

# RevenueCat
REVENUECAT_SECRET_API_KEY=
REVENUECAT_WEBHOOK_AUTH=
