# ── Secrets — never commit ─────────────────────────────────────────────────
# Environment files (commit only the *.example templates)
.env
.env.*
*.env
!.env.example
!*.env.example

# Private keys, certificates and keystores
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*

# Cloud / service credentials
credentials*.json
service-account*.json
*-credentials.json
.aws/
*.tfstate
*.tfstate.*

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# ── Node / frontend ───────────────────────────────────────────────────────
node_modules/
Frontend/build/
coverage/

