# Copy to .env and fill in. REACT_APP_* values are baked into the public
# JS bundle at build time — never put secrets here.

# Backend base URL (no trailing slash)
REACT_APP_API_URL=http://127.0.0.1:10000

# Voice-agent WebSocket (defaults to ws(s)://<host>:10000/ws/voice-agent)
REACT_APP_VOICE_AGENT_WS_URL=
REACT_APP_WS_URL=

# Google Identity Services OAuth client ID
REACT_APP_GOOGLE_CLIENT_ID=

# RevenueCat Web Billing (public keys only)
REACT_APP_REVENUECAT_WEB_PUBLIC_API_KEY=
REACT_APP_REVENUECAT_WEB_SANDBOX_API_KEY=
REACT_APP_REVENUECAT_PUBLIC_API_KEY=
REACT_APP_REVENUECAT_CURRENCY=
REACT_APP_REVENUECAT_PLAN_OFFERING_MAP_JSON=
